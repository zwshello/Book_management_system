# Root Compose template. Prefer scripts/setup_dev_env.py, which generates local
# MySQL secrets and matching service .env files without overwriting existing files.
# Generic MYSQL_DATABASE/USER/PASSWORD are examples, not Compose credentials.
GATEWAY_PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=CHANGE_TO_SERVICE_DATABASE
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
USER_MYSQL_DATABASE=user_db
BOOK_MYSQL_DATABASE=book_db
BORROW_MYSQL_DATABASE=borrow_db
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_LOCAL_HEX_PASSWORD
USER_MYSQL_PASSWORD=CHANGE_ME_GENERATE_LOCAL_HEX_PASSWORD
BOOK_MYSQL_PASSWORD=CHANGE_ME_GENERATE_LOCAL_HEX_PASSWORD
BORROW_MYSQL_PASSWORD=CHANGE_ME_GENERATE_LOCAL_HEX_PASSWORD

DJANGO_SECRET_KEY=CHANGE_ME_USE_A_UNIQUE_KEY_FOR_EACH_SERVICE

USER_SERVICE_URL=http://127.0.0.1:8001
BOOK_SERVICE_URL=http://127.0.0.1:8002
BORROW_SERVICE_URL=http://127.0.0.1:8003
STATISTICS_SERVICE_URL=http://127.0.0.1:8004

# Borrow policy lives in services/borrow-service/.env; these root values are
# historical examples and are not passed to that service by Compose.
MAX_ACTIVE_BORROWS=5
BORROW_DAYS=30
