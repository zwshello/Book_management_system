# Stage 2 routing sketch. Container upstream names and full deployment are
# verified and finalized in stage 10.
server {
    listen 8080;
    server_name _;

    location / {
        proxy_pass http://frontend:80;
    }

    location /api/v1/auth/ { proxy_pass http://user-service:8001; }
    location /api/v1/users { proxy_pass http://user-service:8001; }
    location /api/v1/books { proxy_pass http://book-service:8002; }
    location /api/v1/categories { proxy_pass http://book-service:8002; }
    location /api/v1/borrows { proxy_pass http://borrow-service:8003; }
    location /api/v1/statistics { proxy_pass http://statistics-service:8004; }
}
