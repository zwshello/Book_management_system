DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_VALUE
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=user_db
MYSQL_USER=user_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_TEST_DATABASE=user_db_test
# RSA PEM strings, escaped newlines. Generate with scripts/setup_user_jwt.py.
JWT_PRIVATE_KEY=CHANGE_ME_GENERATE_LOCAL_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=CHANGE_ME_GENERATE_LOCAL_RSA_PUBLIC_KEY
JWT_ISSUER=library-user-service
JWT_AUDIENCE=library-services
# Credential accepted only by the internal book authorization endpoint.
BOOK_SERVICE_TOKEN=CHANGE_ME_GENERATE_LOCAL_SERVICE_TOKEN
BORROW_SERVICE_TOKEN=CHANGE_ME_GENERATE_LOCAL_BORROW_SERVICE_TOKEN
STATISTICS_SERVICE_TOKEN=CHANGE_ME_GENERATE_LOCAL_STATISTICS_SERVICE_TOKEN
